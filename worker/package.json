{
  "name": "bits-mail-cloudflare-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cf:config": "node ../scripts/gen-wrangler.mjs",
    "dev": "wrangler dev --config ../wrangler.jsonc",
    "lint": "eslint src",
    "deploy": "wrangler deploy --config ../wrangler.jsonc --minify",
