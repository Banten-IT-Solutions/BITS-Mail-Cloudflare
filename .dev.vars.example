# Salin ke `.dev.vars` untuk wrangler dev lokal (file ter-gitignore).
# Ini adalah SECRETS — jangan commit. Untuk production, isi via `wrangler secret put`
# atau GitHub Secrets → workflow akan `wrangler secret bulk`.

JWT_SECRET=dev-jwt-secret-min-32-char-ganti-di-production
ADMIN_PASSWORD=your-secure-admin-password
# Alternatif multiple admin (JSON array string):
# ADMIN_PASSWORDS=["your-secure-password","another-secure-password"]
CF_TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Telegram (required for bot feature):
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TG_BOT_INFO={"token":"123:abc","username":"your_bot"}
# Email sending (opsional):
# RESEND_TOKEN=re_xxxxxxxx
# SMTP_CONFIG={"mail.yourdomain.com":{"host":"smtp.example.com","port":587,"auth":{"user":"...","pass":"..."}}}
# S3 (opsional):
# S3_ENDPOINT=https://s3.example.com
# S3_ACCESS_KEY_ID=akid
# S3_SECRET_ACCESS_KEY=secret
# S3_BUCKET=your-bucket
# S3_URL_EXPIRES=360
