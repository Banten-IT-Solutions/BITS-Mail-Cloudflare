# Salin ke `.env` untuk development lokal (file .env ter-gitignore).
# Nilai-nilai ini mensubstitusi placeholder ${VAR} di wrangler.template.jsonc
# saat `pnpm cf:config` dijalankan (otomatis sebelum dev/build/deploy).
#
# Di CI/CD, nilai yang sama diisi lewat GitHub Secrets — lihat README.

# ── Worker & Domain ─────────────────────────────────────────────────────
WORKER_NAME=bits-mail-cloudflare
WORKER_DOMAIN=mail.yourdomain.com
# Alternatif: APP_DOMAIN untuk kompatibilitas dengan konfigurasi lain
# APP_DOMAIN=mail.yourdomain.com

# ── D1 & KV (from output of `wrangler d1 create` / `kv namespace create`) ─
D1_DATABASE_NAME=bits-mail-cloudflare
D1_DATABASE_ID=your-d1-database-id
KV_NAMESPACE_ID=your-kv-namespace-id

# ── Domain Mail ─────────────────────────────────────────────────────────
# WAJIB: JSON array string, contoh: ["mail.yourdomain.com","example.com"]
DEFAULT_DOMAINS=["mail.yourdomain.com"]
DOMAINS=["mail.yourdomain.com"]

# ── Vars umum (opsional tapi direkomendasikan) ─────────────────────────
ADDRESS_PREFIX=tmp
DEFAULT_LANG=en
WORKER_TITLE=BITS Mail Cloudflare
FRONTEND_URL=https://mail.yourdomain.com

# Boolean harus "true"/"false" (tanpa kutip ganda di .env, generator akan handle)
ENABLE_USER_CREATE_EMAIL=true
DISABLE_ANONYMOUS_USER_CREATE_EMAIL=false
ENABLE_USER_DELETE_EMAIL=true
ENABLE_AI_EMAIL_EXTRACT=false
AI_EXTRACT_MODEL=@cf/meta/llama-3-8b-instruct
CF_TURNSTILE_SITE_KEY=your-turnstile-site-key

# S3-compatible storage (opsional) — untuk attachment via R2/MinIO/etc.
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_BUCKET=your-bucket-name
S3_URL_EXPIRES=360

# ── Secrets (JANGAN taruh di .env untuk production) ───────────────────
# Lokal: taruh di .dev.vars (wrangler dev otomatis load)
# CI: isi GitHub Secrets → wrangler secret put
#   JWT_SECRET, ADMIN_PASSWORD / ADMIN_PASSWORDS,
#   CF_TURNSTILE_SECRET_KEY, TG_BOT_INFO, RESEND_TOKEN, SMTP_CONFIG, dll.
# Contoh .dev.vars:
# JWT_SECRET=dev-secret-min-32-char
# ADMIN_PASSWORD=your-secure-admin-password
# CF_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
